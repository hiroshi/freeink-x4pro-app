# Copy this file to .env (gitignored — never commit real credentials) and
# fill in real values. `make build`/`make upload` load .env automatically and
# pass these through to platformio.ini's build_flags as -D defines consumed
# by src/main.cpp (WIFI_SSID / WIFI_PASSWORD / FETCH_URL).
#
# No quotes, no spaces around "=". Values are embedded as a C string literal
# as-is, so avoid a literal `"` or `\` in any of them.
#
# Alternative: export these as real shell environment variables instead of
# using .env — platformio.ini reads whichever is present at build time.

WIFI_SSID=
WIFI_PASSWORD=
# http:// or https:// (https verifies nothing — see the setInsecure() note
# next to fetchArticleText() in src/main.cpp).
FETCH_URL=
